---
import BaseLayout from '@/layouts/BaseLayout.astro';
import config from '@/data/site.config';

const legalPageTitle = 'Legal Notice';
const legalPageDescription = 'Legal information and mandatory notices for this website.';
const legalPageUrl = new URL(Astro.url.pathname, config.domain).toString();
---

<BaseLayout title="Legal Notice | IM8 Discount Code" description="Legal notice for IM8 Discount Code, including publisher information, editorial responsibility, affiliate disclosure and contact details.">

  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: config.domain },
      { '@type': 'ListItem', position: 2, name: legalPageTitle, item: legalPageUrl },
    ],
  })} />

  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: legalPageTitle,
    headline: legalPageTitle,
    description: legalPageDescription,
    url: legalPageUrl,
    isPartOf: { '@type': 'WebSite', name: config.siteName, url: config.domain },
  })} />
  <main class="padding-section-medium" style="background-color: #ffffff;">
    <div class="container-large" style="max-width: 72rem; margin: 0 auto;">
      <h1 style="font-size: clamp(1.75rem, 1.2rem + 2.75vw, 2.5rem); color: #242424; margin-bottom: 2rem;">Legal Notice</h1>
      <div style="color: #333; line-height: 1.625; font-size: 14px; max-width: 48rem;">
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">1. Publisher</h2>
        <p>The website <strong>IM8 Discount Code</strong> is published by:</p>
        <p><strong>Éditeur du site</strong><br>Share capital: 10,000.00 MAD<br>ICE: 003858984000079<br>RC: 174701 - Marrakech Trade Register<br>Tax ID: 71070947<br>Registered office: Quartier Industriel Sidi Ghanem, Lot N°208, Bureau N°DH7, Marrakech, Morocco<br>Email: contact [at] ce site</p>
        <p><em>Publication director: Elias Abdallah, Managing Director</em></p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">2. Hosting provider</h2>
        <p>The website is hosted by:</p>
        <p><strong>Cloudflare, Inc.</strong><br>101 Townsend Street<br>San Francisco, CA 94107<br>United States<br>Phone: +1 (650) 319-8930</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">3. Intellectual property</h2>
        <p>All content on this website, including text, images, graphics, logos, videos, audio and trademarks, is protected by copyright and trademark law. Any reproduction, representation, modification, publication or adaptation of all or part of the website content is prohibited without prior written permission from the publisher.</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">4. Liens externes</h2>
        <p>This website contains external links. When you click certain links and make a purchase, the publisher may receive compensation. This does not affect the price you pay or our product evaluation. We recommend products based on editorial analysis, product information and perceived quality.</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">5. Liability</h2>
        <p>The information published on this website is provided for informational purposes only and does not constitute medical advice, diagnosis or prescription. Always consult a qualified healthcare professional before starting supplementation or changing your diet.</p>
        <p>The publisher makes reasonable efforts to provide accurate and up-to-date information but cannot be held liable for errors, omissions or outcomes resulting from the use of this information.</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">6. Contact</h2>
        <p>For any question about this website or this legal notice, contact us at: <strong>contact [at] ce site</strong></p>
      </div>
    </div>
  </main>
</BaseLayout>
