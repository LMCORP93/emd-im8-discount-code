---
import BaseLayout from '@/layouts/BaseLayout.astro';
import config from '@/data/site.config';

const legalPageTitle = 'Privacy Policy';
const legalPageDescription = 'Privacy information and data processing policy for this website.';
const legalPageUrl = new URL(Astro.url.pathname, config.domain).toString();
---

<BaseLayout title="Privacy Policy | IM8 Discount Code" description="Privacy policy for IM8 Discount Code, including personal data use, cookies, analytics, external links and contact information.">

  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: config.domain },
      { '@type': 'ListItem', position: 2, name: legalPageTitle, item: legalPageUrl },
    ],
  })} />

  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: legalPageTitle,
    headline: legalPageTitle,
    description: legalPageDescription,
    url: legalPageUrl,
    isPartOf: { '@type': 'WebSite', name: config.siteName, url: config.domain },
  })} />
  <main class="padding-section-medium" style="background-color: #ffffff;">
    <div class="container-large" style="max-width: 72rem; margin: 0 auto;">
      <h1 style="font-size: clamp(1.75rem, 1.2rem + 2.75vw, 2.5rem); color: #242424; margin-bottom: 2rem;">Privacy Policy</h1>
      <div style="color: #333; line-height: 1.625; font-size: 14px; max-width: 48rem;">
        <p style="margin-bottom: 0.75rem;">This privacy policy explains how personal data may be collected, processed and protected when using the <strong>IM8 Discount Code</strong> website.</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">1. Data controller</h2>
        <p><strong>Éditeur du site</strong><br>Registered office: Quartier Industriel Sidi Ghanem, Lot N°208, Bureau N°DH7, Marrakech, Morocco<br>ICE: 003858984000079<br>Tax ID: 71070947<br>Email: hello@le-meilleur-complement.fr</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">2. Data collected</h2>
        <p>We may collect browsing data such as IP address, browser type, visited pages, session duration and traffic source. We may also collect interaction data related to affiliate link clicks and contact data if you contact us directly.</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">3. Purpose of processing</h2>
        <p>Collected data is used to operate and secure the website, measure audience performance, improve content quality, track performance and respond to contact requests.</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">4. Cookies</h2>
        <p>The website may use technical cookies, analytics cookies. You can manage cookie preferences from your browser settings at any time.</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">5. Data sharing</h2>
        <p>Personal data is never sold. It may be shared with technical providers such as Cloudflare, analytics tools, technical providers for tracking purposes, or competent authorities when legally required.</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">6. Retention</h2>
        <p>Browsing data is retained for a limited period. Contact data is retained only as long as necessary to handle the request. Affiliate cookies usually last between 30 and 90 days depending on the partner.</p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">7. Your rights</h2>
        <p>You may request access, correction, deletion, objection or portability of your personal data by contacting: <strong>hello@le-meilleur-complement.fr</strong></p>
        <h2 style="font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); color: #242424; margin-top: 1rem; margin-bottom: 0.75rem;">8. Updates</h2>
        <p>This privacy policy may be updated at any time. Any update will be published on this page.</p>
        <p><em>Last updated: April 27, 2026</em></p>
      </div>
    </div>
  </main>
</BaseLayout>
